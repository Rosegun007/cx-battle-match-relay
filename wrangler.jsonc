{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cx-battle-match-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CX_MATCH_HUB",
        "class_name": "CXMatchHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CXMatchHub"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "CX_PLAYERS_DB",
      "database_name": "cx-battle-players",
      "database_id": "a53b5191-558e-41b5-9f36-738ec47fe76c"
    }
  ]
}
